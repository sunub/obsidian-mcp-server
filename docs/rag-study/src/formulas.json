{
	"bm25": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>score</mtext><mo stretchy=\"false\">(</mo><mi>D</mi><mo separator=\"true\">,</mo><mi>Q</mi><mo stretchy=\"false\">)</mo><mo>=</mo><munder><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi>Q</mi></mrow></munder><mtext>IDF</mtext><mo stretchy=\"false\">(</mo><mi>q</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mfrac><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo separator=\"true\">,</mo><mi>D</mi><mo stretchy=\"false\">)</mo><mtext> </mtext><mo stretchy=\"false\">(</mo><msub><mi>k</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>f</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo separator=\"true\">,</mo><mi>D</mi><mo stretchy=\"false\">)</mo><mo>+</mo><msub><mi>k</mi><mn>1</mn></msub><mrow><mo fence=\"true\">(</mo><mn>1</mn><mo>−</mo><mi>b</mi><mo>+</mo><mi>b</mi><mtext> </mtext><mfrac><mrow><mi mathvariant=\"normal\">∣</mi><mi>D</mi><mi mathvariant=\"normal\">∣</mi></mrow><mtext>avgdl</mtext></mfrac><mo fence=\"true\">)</mo></mrow></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\text{score}(D,Q)=\\sum_{q\\in Q}\\text{IDF}(q)\\cdot\\frac{f(q,D)\\,(k_1+1)}{f(q,D)+k_1\\left(1-b+b\\,\\frac{|D|}{\\text{avgdl}}\\right)}</annotation></semantics></math></span>",
	"idf": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>IDF</mtext><mo stretchy=\"false\">(</mo><mi>q</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mi>ln</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence=\"true\">(</mo><mn>1</mn><mo>+</mo><mfrac><mrow><mi>N</mi><mo>−</mo><mi>n</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mn>0.5</mn></mrow><mrow><mi>n</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo stretchy=\"false\">)</mo><mo>+</mo><mn>0.5</mn></mrow></mfrac><mo fence=\"true\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">\\text{IDF}(q)=\\ln\\!\\left(1+\\frac{N-n(q)+0.5}{n(q)+0.5}\\right)</annotation></semantics></math></span>",
	"proj": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>score</mtext><mo stretchy=\"false\">(</mo><mi>D</mi><mo separator=\"true\">,</mo><mi>Q</mi><mo stretchy=\"false\">)</mo><mo>=</mo><munder><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi>Q</mi><mo separator=\"true\">,</mo><mtext>  </mtext><mi>q</mi><mo>∈</mo><mi>D</mi></mrow></munder><mrow><mo fence=\"true\">(</mo><mi>ln</mi><mo>⁡</mo><mfrac><mi>N</mi><mrow><mi>n</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo stretchy=\"false\">)</mo></mrow></mfrac><mo>+</mo><mn>1</mn><mo fence=\"true\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">\\text{score}(D,Q)=\\sum_{q\\in Q,\\;q\\in D}\\left(\\ln\\frac{N}{n(q)}+1\\right)</annotation></semantics></math></span>",
	"tfidf": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>tf-idf</mtext><mo stretchy=\"false\">(</mo><mi>q</mi><mo separator=\"true\">,</mo><mi>D</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mi>f</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo separator=\"true\">,</mo><mi>D</mi><mo stretchy=\"false\">)</mo><mo>⋅</mo><mi>log</mi><mo>⁡</mo><mfrac><mi>N</mi><mrow><mi>n</mi><mo stretchy=\"false\">(</mo><mi>q</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\text{tf-idf}(q,D)=f(q,D)\\cdot\\log\\frac{N}{n(q)}</annotation></semantics></math></span>",
	"rrf": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>RRF</mtext><mo stretchy=\"false\">(</mo><mi>d</mi><mo stretchy=\"false\">)</mo><mo>=</mo><munder><mo>∑</mo><mrow><mi>r</mi><mo>∈</mo><mi>R</mi></mrow></munder><mfrac><mn>1</mn><mrow><mi>k</mi><mo>+</mo><msub><mtext>rank</mtext><mi>r</mi></msub><mo stretchy=\"false\">(</mo><mi>d</mi><mo stretchy=\"false\">)</mo></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\text{RRF}(d)=\\sum_{r\\in R}\\frac{1}{k+\\text{rank}_r(d)}</annotation></semantics></math></span>",
	"cos": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>cos</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi mathvariant=\"bold\">q</mi><mo separator=\"true\">,</mo><mi mathvariant=\"bold\">d</mi><mo stretchy=\"false\">)</mo><mo>=</mo><mfrac><mrow><mi mathvariant=\"bold\">q</mi><mo>⋅</mo><mi mathvariant=\"bold\">d</mi></mrow><mrow><mo stretchy=\"false\">∥</mo><mi mathvariant=\"bold\">q</mi><mo stretchy=\"false\">∥</mo><mtext> </mtext><mo stretchy=\"false\">∥</mo><mi mathvariant=\"bold\">d</mi><mo stretchy=\"false\">∥</mo></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\cos(\\mathbf{q},\\mathbf{d})=\\frac{\\mathbf{q}\\cdot\\mathbf{d}}{\\lVert\\mathbf{q}\\rVert\\,\\lVert\\mathbf{d}\\rVert}</annotation></semantics></math></span>",
	"recall": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>Recall@</mtext><mi>k</mi><mo>=</mo><mfrac><mrow><mi mathvariant=\"normal\">∣</mi><mo stretchy=\"false\">{</mo><mtext>정답</mtext><mo stretchy=\"false\">}</mo><mo>∩</mo><mo stretchy=\"false\">{</mo><mtext>상위 </mtext><mi>k</mi><mo stretchy=\"false\">}</mo><mi mathvariant=\"normal\">∣</mi></mrow><mrow><mi mathvariant=\"normal\">∣</mi><mo stretchy=\"false\">{</mo><mtext>정답</mtext><mo stretchy=\"false\">}</mo><mi mathvariant=\"normal\">∣</mi></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\text{Recall@}k=\\frac{|\\{\\text{정답}\\}\\cap\\{\\text{상위 }k\\}|}{|\\{\\text{정답}\\}|}</annotation></semantics></math></span>",
	"mrr": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>MRR</mtext><mo>=</mo><mfrac><mn>1</mn><mrow><mi mathvariant=\"normal\">∣</mi><mi>Q</mi><mi mathvariant=\"normal\">∣</mi></mrow></mfrac><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi mathvariant=\"normal\">∣</mi><mi>Q</mi><mi mathvariant=\"normal\">∣</mi></mrow></munderover><mfrac><mn>1</mn><msub><mtext>rank</mtext><mi>i</mi></msub></mfrac></mrow><annotation encoding=\"application/x-tex\">\\text{MRR}=\\frac{1}{|Q|}\\sum_{i=1}^{|Q|}\\frac{1}{\\text{rank}_i}</annotation></semantics></math></span>",
	"ndcg": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mtext>DCG@</mtext><mi>k</mi><mo>=</mo><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mfrac><mrow><msup><mn>2</mn><mrow><mi>r</mi><mi>e</mi><msub><mi>l</mi><mi>i</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mrow><msub><mrow><mi>log</mi><mo>⁡</mo></mrow><mn>2</mn></msub><mo stretchy=\"false\">(</mo><mi>i</mi><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow></mfrac><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mtext>nDCG@</mtext><mi>k</mi><mo>=</mo><mfrac><mrow><mtext>DCG@</mtext><mi>k</mi></mrow><mrow><mtext>IDCG@</mtext><mi>k</mi></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\text{DCG@}k=\\sum_{i=1}^{k}\\frac{2^{rel_i}-1}{\\log_2(i+1)},\\quad \\text{nDCG@}k=\\frac{\\text{DCG@}k}{\\text{IDCG@}k}</annotation></semantics></math></span>",
	"k0": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn><mtext>  </mtext><mo>⇒</mo><mtext>  </mtext><mfrac><mrow><mi>f</mi><mtext> </mtext><mo stretchy=\"false\">(</mo><mn>0</mn><mo>+</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>f</mi><mo>+</mo><mn>0</mn></mrow></mfrac><mo>=</mo><mn>1</mn><mspace width=\"1em\"/><mo stretchy=\"false\">(</mo><mi>f</mi><mo>&gt;</mo><mn>0</mn><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">k_1=0\\;\\Rightarrow\\;\\frac{f\\,(0+1)}{f+0}=1\\quad(f&gt;0)</annotation></semantics></math></span>"
}
